# ─────────────────────────────────────────────────────────
#  ATENCIÓN: todas las variables VITE_* se incrustan en el JavaScript
#  que descarga el navegador, así que son PÚBLICAS.
#  Nunca pongas aquí claves de API, contraseñas ni secretos:
#  esos van en backend/.env o ai/.env.
# ─────────────────────────────────────────────────────────

# URL de la API. En desarrollo no hace falta: Vite redirige /api a localhost:3000
# VITE_API_URL=https://tu-servidor/api
