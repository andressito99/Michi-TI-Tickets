# ─────────────────────────────────────────────────────────
#  Plantilla de configuración. Copia este archivo como .env
#  y rellena los valores. El archivo .env NUNCA se sube a git.
# ─────────────────────────────────────────────────────────

# API de DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat (rápido) o deepseek-reasoner (razonamiento, más lento)
DEEPSEEK_MODEL=deepseek-chat

# Obligatorio (mínimo 16 caracteres): el MISMO valor que AI_SERVICE_TOKEN en backend/.env
AI_SERVICE_TOKEN=

# Activa /docs (documentación interactiva) solo en desarrollo
AI_ENABLE_DOCS=false
