# ─────────────────────────────────────────────────────────
#  Plantilla de configuración. Copia este archivo como .env
#  y rellena los valores. El archivo .env NUNCA se sube a git.
#  Genera secretos con:
#    node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────

# ── Servidor ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Orígenes permitidos (separados por coma). Obligatorio en producción.
CORS_ORIGINS=http://localhost:5173

# ── MySQL de MAMP ────────────────────────────────────────
# MAMP en Windows usa el puerto 3306; en macOS suele ser 8889.
# Recomendado: un usuario propio para la app en lugar de root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ti_tickets

# ── Autenticación (obligatorio, mínimo 32 caracteres) ────
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ── Servicio de IA (Python + DeepSeek) ───────────────────
AI_SERVICE_URL=http://127.0.0.1:8000
# Obligatorio (mínimo 16 caracteres). Debe ser igual a AI_SERVICE_TOKEN en ai/.env
AI_SERVICE_TOKEN=

# ── Contraseñas de los usuarios demo (npm run db:seed) ───
# Si se dejan vacías se generan al azar y se muestran en consola.
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=
SEED_USER_PASSWORD=

# ── Solo para scripts/migrate-from-supabase.js ───────────
SUPABASE_URL=
SUPABASE_KEY=

# ── Capturas adjuntas ─────────────────────────────────────
# Carpeta donde se guardan (relativa a backend/). Nunca debe estar dentro de la web.
UPLOAD_DIR=uploads
# Tamaño máximo de cada imagen, en MB
MAX_UPLOAD_MB=5
