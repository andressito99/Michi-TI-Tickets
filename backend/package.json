{
  "name": "ti-tickets-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST de TI-Tickets (Node.js + MySQL)",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:init": "node --env-file-if-exists=.env scripts/db-init.js",
    "db:seed": "node --env-file-if-exists=.env scripts/db-init.js --seed",
    "db:migrate-supabase": "node --env-file-if-exists=.env scripts/migrate-from-supabase.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4"
  }
}
