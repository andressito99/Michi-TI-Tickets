# ─────────────────────────────────────────────────────────────
#  El proyecto vive dentro de htdocs de MAMP, así que Apache podría
#  servir cualquier archivo: .env con secretos, .git, código fuente…
#  La app NO usa Apache (la API corre en Node y la web en Vite),
#  por eso se bloquea el acceso web a toda esta carpeta.
# ─────────────────────────────────────────────────────────────

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

Options -Indexes
